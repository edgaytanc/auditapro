  "patrones_regex": [
    {
      "pattern": "Entidad\\s+X{3,}",
      "reemplazar_por": "[ENTIDAD_ETIQUETA]"
    },
    {
      "_comentario": "Periodo del encabezado. Tolera que falte el 'al' y que el primer mes traiga o no su anio, porque las plantillas oficiales mezclan las tres formas (p. ej. 'Del 01 de Enero 31 de Diciembre de 2025').",
      "pattern": "Del\\s+\\d{1,2}\\s+de\\s+[A-Za-z\u00c1\u00c9\u00cd\u00d3\u00da\u00e1\u00e9\u00ed\u00f3\u00fa]+(?:\\s+de\\s+\\d{4})?\\s+(?:al\\s+)?\\d{1,2}\\s+de\\s+[A-Za-z\u00c1\u00c9\u00cd\u00d3\u00da\u00e1\u00e9\u00ed\u00f3\u00fa]+\\s+de\\s+\\d{4}",
      "reemplazar_por": "[FECHA_RANGO]"
    },
    {
      "pattern": "Cifras expresadas en [A-Za-z\u00e1\u00e9\u00ed\u00f3\u00fa\u00fc ]+",
      "reemplazar_por": "[MONEDA_EXPRESION]"
    },
    {
      "pattern": "Entidad:\\s*",
      "reemplazar_por": "[ENTIDAD_COMPLETA]"
    },
    {
      "pattern": "Auditor[ií]a:\\s*",
      "reemplazar_por": "[AUDITORIA_COMPLETA]"
    },
    {
      "pattern": "Per[ií]odo:\\s*",
      "reemplazar_por": "[FECHA_RANGO_COMPLETA]"
    }
  ]
}